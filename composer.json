{
    "name": "kachkolasa/shiplog",
    "description": "Turn a week of git history into a status update you can send a client.",
    "keywords": ["cli", "git", "changelog", "release-notes", "claude", "anthropic"],
    "homepage": "https://github.com/kachkolasa/shiplog",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/kachkolasa/shiplog/issues",
        "source": "https://github.com/kachkolasa/shiplog"
    },
    "authors": [
        {
            "name": "Kachkol",
            "email": "kachkolasa@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "anthropic-ai/sdk": "^1.3",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8 || ^5.0.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["shiplog"]
}
